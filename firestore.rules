rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // deleteAccount writes accountDeletions/{uid} until stale ID tokens expire (~1 hour).
    // pruneAccountDeletionTombstones removes completed markers after 48 hours.
    function hasAccountDeletionTombstone() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }

    function listDoc(listId) {
      return get(/databases/$(database)/documents/lists/$(listId));
    }

    function listData(listId) {
      return listDoc(listId).data;
    }

    function isOwner(listData) {
      return isAuthenticated() && listData.ownerId == request.auth.uid;
    }

    function isCollaborator(listData) {
      return isAuthenticated() &&
        listData.collaboratorIds != null &&
        (request.auth.uid in listData.collaboratorIds);
    }

    function isEditor(listData) {
      return isOwner(listData) ||
        (isAuthenticated() && listData.editorIds != null && request.auth.uid in listData.editorIds);
    }

    function canReadList(listId) {
      let data = listData(listId);
      return data.isPublic == true || isOwner(data) || isCollaborator(data);
    }

    // Always validate place reads against the parent list so listId queries
    // (including empty lists) satisfy Firestore query security rules.
    function canReadPlace() {
      return resource.data.listId is string && canReadList(resource.data.listId);
    }

    function canWriteList(listId) {
      let data = listData(listId);
      return isOwner(data) || isEditor(data);
    }

    function normalizedCollaboratorIds(list) {
      return list.collaboratorIds != null ? list.collaboratorIds : [list.ownerId];
    }

    // Denormalized place access fields must mirror the parent list on writes.
    function placeDenormMatchesList(listId) {
      let list = listData(listId);
      let data = request.resource.data;
      return !(data.listOwnerId is string) || (
        data.listOwnerId == list.ownerId &&
        data.listIsPublic == (list.isPublic == true) &&
        data.listCollaboratorIds == normalizedCollaboratorIds(list)
      );
    }

    function placeDenormUpdateValid(listId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny(['listOwnerId', 'listIsPublic', 'listCollaboratorIds']) ||
        placeDenormMatchesList(listId);
    }

    function currentUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function isInvitationRecipient(invitation) {
      return isAuthenticated() && (
        (invitation.invitedEmail != null && invitation.invitedEmail == request.auth.token.email) ||
        (invitation.invitedUsername != null && invitation.invitedUsername == currentUsername())
      );
    }

    // LISTS
    match /lists/{listId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data) || isCollaborator(resource.data);

      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        !hasAccountDeletionTombstone();

      allow update: if isOwner(resource.data) || isEditor(resource.data);

      allow delete: if isOwner(resource.data);

      // PLACES (Subcollection)
      match /places/{placeId} {
        allow read: if canReadList(listId);
        allow write: if canWriteList(listId);
      }
    }

    // PLACES (top-level collection, linked to lists via listId field)
    match /places/{placeId} {
      allow read: if isAuthenticated() &&
                     resource.data.listId is string &&
                     canReadPlace();

      allow create: if isAuthenticated() &&
                       request.resource.data.listId is string &&
                       canWriteList(request.resource.data.listId) &&
                       placeDenormMatchesList(request.resource.data.listId);

      allow update: if isAuthenticated() &&
                       resource.data.listId is string &&
                       canWriteList(resource.data.listId) &&
                       request.resource.data.listId == resource.data.listId &&
                       placeDenormUpdateValid(resource.data.listId);

      allow delete: if isAuthenticated() &&
                       resource.data.listId is string &&
                       canWriteList(resource.data.listId);
    }

    // PLACES CACHE (legacy — removed after googlePlaces cutover)
    match /places_cache/{placeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    function canReadListPlaceMembership() {
      return resource.data.listId is string && canReadList(resource.data.listId);
    }

    // Canonical Google place metadata (one doc per googlePlaceId)
    match /googlePlaces/{googlePlaceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Per-list place memberships (list-specific status, notes, etc.)
    match /listPlaces/{membershipId} {
      allow read: if isAuthenticated() && canReadListPlaceMembership();

      allow create: if isAuthenticated() &&
        request.resource.data.listId is string &&
        canWriteList(request.resource.data.listId);

      allow update: if isAuthenticated() &&
        resource.data.listId is string &&
        canWriteList(resource.data.listId) &&
        request.resource.data.listId == resource.data.listId;

      allow delete: if isAuthenticated() &&
        resource.data.listId is string &&
        canWriteList(resource.data.listId);
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId && !hasAccountDeletionTombstone();
    }

    // ACCOUNT DELETIONS (server-written tombstone; client reads to block orphan recovery)
    match /accountDeletions/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
    }

    // USERNAMES
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        !hasAccountDeletionTombstone();
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        !hasAccountDeletionTombstone();
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        !hasAccountDeletionTombstone();
    }

    // INVITATIONS
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() && (
        resource.data.invitedBy == request.auth.uid ||
        isInvitationRecipient(resource.data) ||
        canWriteList(resource.data.listId)
      );

      allow create: if isAuthenticated() &&
        request.resource.data.invitedBy == request.auth.uid &&
        canWriteList(request.resource.data.listId);

      // Inviter can cancel; invitees can decline. Accept runs via Cloud Function.
      allow update: if isAuthenticated() && (
        resource.data.invitedBy == request.auth.uid ||
        (
          isInvitationRecipient(resource.data) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'declined' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );

      allow delete: if isAuthenticated() && resource.data.invitedBy == request.auth.uid;
    }
  }
}
