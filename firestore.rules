rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function listDoc(listId) {
      return get(/databases/$(database)/documents/lists/$(listId));
    }

    function listData(listId) {
      return listDoc(listId).data;
    }

    function isOwner(listData) {
      return isAuthenticated() && listData.ownerId == request.auth.uid;
    }

    function isCollaborator(listData) {
      return isAuthenticated() && (request.auth.uid in listData.collaboratorIds);
    }

    function isEditor(listData) {
      // Find the collaborator's role
      let collabs = listData.collaborators;
      // In a real production environment, you may want to structure collaborators as a map for easier rule checking:
      // collaborators: { "userId1": "editor", "userId2": "viewer" }
      // For now, this is a simplified check if they are at least in the array
      return isCollaborator(listData);
    }

    function canReadList(listId) {
      let data = listData(listId);
      return data.isPublic == true || isOwner(data) || isCollaborator(data);
    }

    function canWriteList(listId) {
      let data = listData(listId);
      return isOwner(data) || isEditor(data);
    }

    // LISTS
    match /lists/{listId} {
      // Anyone can read a public list, or if they are the owner/collaborator
      allow read: if resource.data.isPublic == true || isOwner(resource.data) || isCollaborator(resource.data);

      // Only authenticated users can create lists
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      // Only owners or editors can update the list (invitation accept uses a Cloud Function)
      allow update: if isOwner(resource.data) || isEditor(resource.data);

      // Only owners can delete the list
      allow delete: if isOwner(resource.data);

      // PLACES (Subcollection)
      match /places/{placeId} {
        // Inherit read permissions from the parent list
        allow read: if listData(listId).isPublic == true ||
                       isOwner(listData(listId)) ||
                       isCollaborator(listData(listId));

        // Inherit write permissions from parent list
        allow write: if isOwner(listData(listId)) || isEditor(listData(listId));
      }
    }

    // PLACES (top-level collection, linked to lists via listId field)
    match /places/{placeId} {
      allow read: if isAuthenticated() &&
                     resource.data.listId is string &&
                     canReadList(resource.data.listId);

      allow create: if isAuthenticated() &&
                       request.resource.data.listId is string &&
                       canWriteList(request.resource.data.listId);

      allow update: if isAuthenticated() &&
                       resource.data.listId is string &&
                       canWriteList(resource.data.listId) &&
                       request.resource.data.listId == resource.data.listId;

      allow delete: if isAuthenticated() &&
                       resource.data.listId is string &&
                       canWriteList(resource.data.listId);
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId;
    }

    // USERNAMES
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // INVITATIONS
    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.invitedBy == request.auth.uid;
      // Inviter can cancel; invitees can decline. Accept runs via Cloud Function.
      allow update: if isAuthenticated() && (
        resource.data.invitedBy == request.auth.uid ||
        (
          resource.data.status == 'pending' &&
          request.resource.data.status == 'declined' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );
      allow delete: if isAuthenticated() && resource.data.invitedBy == request.auth.uid;
    }
  }
}
