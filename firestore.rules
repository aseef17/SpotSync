rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function listDoc(listId) {
      return get(/databases/$(database)/documents/lists/$(listId));
    }

    function listData(listId) {
      return listDoc(listId).data;
    }

    function isOwner(listData) {
      return isAuthenticated() && listData.ownerId == request.auth.uid;
    }

    function isCollaborator(listData) {
      return isAuthenticated() && (request.auth.uid in listData.collaboratorIds);
    }

    function isEditor(listData) {
      return isOwner(listData) ||
        (isAuthenticated() && listData.editorIds != null && request.auth.uid in listData.editorIds);
    }

    function canReadList(listId) {
      let data = listData(listId);
      return data.isPublic == true || isOwner(data) || isCollaborator(data);
    }

    // Denorm fields optimize owner reads on private lists, but public/collaborator
    // access must always be checked against the parent list to avoid stale denorm
    // leaking data after access is revoked (e.g. public -> private).
    function canReadPlace() {
      if (!(resource.data.listOwnerId is string)) {
        return canReadList(resource.data.listId);
      }

      if (resource.data.listIsPublic != true &&
          isAuthenticated() &&
          resource.data.listOwnerId == request.auth.uid) {
        return true;
      }

      return canReadList(resource.data.listId);
    }

    function canWriteList(listId) {
      let data = listData(listId);
      return isOwner(data) || isEditor(data);
    }

    function normalizedCollaboratorIds(list) {
      return list.collaboratorIds != null ? list.collaboratorIds : [list.ownerId];
    }

    // Denormalized place access fields must mirror the parent list on writes.
    function placeDenormMatchesList(listId) {
      let list = listData(listId);
      let data = request.resource.data;

      if (!(data.listOwnerId is string)) {
        return true;
      }

      return data.listOwnerId == list.ownerId &&
        data.listIsPublic == (list.isPublic == true) &&
        data.listCollaboratorIds == normalizedCollaboratorIds(list);
    }

    function placeDenormUpdateValid(listId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      if (!affected.hasAny(['listOwnerId', 'listIsPublic', 'listCollaboratorIds'])) {
        return true;
      }
      return placeDenormMatchesList(listId);
    }

    function currentUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function isInvitationRecipient(invitation) {
      return isAuthenticated() && (
        (invitation.invitedEmail != null && invitation.invitedEmail == request.auth.token.email) ||
        (invitation.invitedUsername != null && invitation.invitedUsername == currentUsername())
      );
    }

    // LISTS
    match /lists/{listId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data) || isCollaborator(resource.data);

      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      allow update: if isOwner(resource.data) || isEditor(resource.data);

      allow delete: if isOwner(resource.data);

      // PLACES (Subcollection)
      match /places/{placeId} {
        allow read: if canReadList(listId);
        allow write: if canWriteList(listId);
      }
    }

    // PLACES (top-level collection, linked to lists via listId field)
    match /places/{placeId} {
      allow read: if isAuthenticated() &&
                     resource.data.listId is string &&
                     canReadPlace();

      allow create: if isAuthenticated() &&
                       request.resource.data.listId is string &&
                       canWriteList(request.resource.data.listId) &&
                       placeDenormMatchesList(request.resource.data.listId);

      allow update: if isAuthenticated() &&
                       resource.data.listId is string &&
                       canWriteList(resource.data.listId) &&
                       request.resource.data.listId == resource.data.listId &&
                       placeDenormUpdateValid(resource.data.listId);

      allow delete: if isAuthenticated() &&
                       resource.data.listId is string &&
                       canWriteList(resource.data.listId);
    }

    // PLACES CACHE
    match /places_cache/{placeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId;
    }

    // USERNAMES
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // INVITATIONS
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() && (
        resource.data.invitedBy == request.auth.uid ||
        isInvitationRecipient(resource.data) ||
        canWriteList(resource.data.listId)
      );

      allow create: if isAuthenticated() &&
        request.resource.data.invitedBy == request.auth.uid &&
        canWriteList(request.resource.data.listId);

      // Inviter can cancel; invitees can decline. Accept runs via Cloud Function.
      allow update: if isAuthenticated() && (
        resource.data.invitedBy == request.auth.uid ||
        (
          isInvitationRecipient(resource.data) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'declined' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );

      allow delete: if isAuthenticated() && resource.data.invitedBy == request.auth.uid;
    }
  }
}
