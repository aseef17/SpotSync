rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isOwner(listData) {
      return isAuthenticated() && listData.ownerId == request.auth.uid;
    }

    function isCollaborator(listData) {
      return isAuthenticated() && (request.auth.uid in listData.collaboratorIds);
    }

    function isEditor(listData) {
      return isOwner(listData) ||
        (isAuthenticated() && listData.editorIds != null && request.auth.uid in listData.editorIds);
    }

    function canReadList(listData) {
      return listData.isPublic == true || isOwner(listData) || isCollaborator(listData);
    }

    function canWriteList(listData) {
      return isOwner(listData) || isEditor(listData);
    }

    function currentUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function isInvitationRecipient(invitation) {
      return isAuthenticated() && (
        (invitation.invitedEmail != null && invitation.invitedEmail == request.auth.token.email) ||
        (invitation.invitedUsername != null && invitation.invitedUsername == currentUsername())
      );
    }

    // LISTS
    match /lists/{listId} {
      allow read: if canReadList(resource.data);

      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      allow update: if canWriteList(resource.data);

      allow delete: if isOwner(resource.data);

      // PLACES (Subcollection)
      match /places/{placeId} {
        allow read: if canReadList(listData(listId));
        allow write: if canWriteList(listData(listId));
      }
    }

    // PLACES (top-level collection, linked to lists via listId field)
    match /places/{placeId} {
      allow read: if isAuthenticated()
        && resource.data.listId is string
        && canReadList(listData(resource.data.listId));

      allow create: if isAuthenticated()
        && request.resource.data.listId is string
        && canWriteList(listData(request.resource.data.listId));

      allow update: if isAuthenticated()
        && resource.data.listId is string
        && request.resource.data.listId == resource.data.listId
        && canWriteList(listData(resource.data.listId));

      allow delete: if isAuthenticated()
        && resource.data.listId is string
        && canWriteList(listData(resource.data.listId));
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId;
    }

    // USERNAMES
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // INVITATIONS
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() && (
        resource.data.invitedBy == request.auth.uid ||
        isInvitationRecipient(resource.data) ||
        canWriteList(listData(resource.data.listId))
      );

      allow create: if isAuthenticated() &&
        request.resource.data.invitedBy == request.auth.uid &&
        canWriteList(listData(request.resource.data.listId));

      allow update: if isAuthenticated() && (
        resource.data.invitedBy == request.auth.uid ||
        isInvitationRecipient(resource.data)
      );

      allow delete: if isAuthenticated() && resource.data.invitedBy == request.auth.uid;
    }

    // PLACES CACHE (shared Google Maps details)
    match /places_cache/{placeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
