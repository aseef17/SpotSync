rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isOwner(listData) {
      return isAuthenticated() && listData.ownerId == request.auth.uid;
    }

    function isCollaborator(listData) {
      return isAuthenticated() && (request.auth.uid in listData.collaboratorIds);
    }

    function isEditor(listData) {
      // Find the collaborator's role
      let collabs = listData.collaborators;
      // In a real production environment, you may want to structure collaborators as a map for easier rule checking:
      // collaborators: { "userId1": "editor", "userId2": "viewer" }
      // For now, this is a simplified check if they are at least in the array
      return isCollaborator(listData);
    }

    function canWriteList(listData) {
      return isOwner(listData) || isEditor(listData);
    }

    function canWritePlaceForList(listId) {
      return canWriteList(listData(listId));
    }

    // Allow invitees to join a list when accepting an invitation (self-add only).
    function isAddingSelfAsCollaborator(listData) {
      return isAuthenticated() &&
        !(request.auth.uid in listData.collaboratorIds) &&
        (request.auth.uid in request.resource.data.collaboratorIds) &&
        request.resource.data.diff(listData).affectedKeys().hasOnly(['collaborators', 'collaboratorIds', 'updatedAt']);
    }

    // LISTS
    match /lists/{listId} {
      // Anyone can read a public list, or if they are the owner/collaborator
      allow read: if resource.data.isPublic == true || isOwner(resource.data) || isCollaborator(resource.data);

      // Only authenticated users can create lists
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      // Only owners, collaborators, or invitees joining themselves can update the list
      allow update: if isOwner(resource.data) || isEditor(resource.data) || isAddingSelfAsCollaborator(resource.data);

      // Only owners can delete the list
      allow delete: if isOwner(resource.data);

      // PLACES (Subcollection)
      match /places/{placeId} {
        // Inherit read permissions from the parent list
        allow read: if listData(listId).isPublic == true ||
                       isOwner(listData(listId)) ||
                       isCollaborator(listData(listId));

        // Inherit write permissions from parent list
        allow write: if canWriteList(listData(listId));
      }
    }

    // PLACES (top-level collection, linked to lists via listId field)
    match /places/{placeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canWritePlaceForList(request.resource.data.listId);
      allow update: if isAuthenticated() && canWritePlaceForList(resource.data.listId);
      allow delete: if isAuthenticated() && canWritePlaceForList(resource.data.listId);
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId;
    }

    // USERNAMES
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // INVITATIONS
    match /invitations/{invitationId} {
      allow read, write: if isAuthenticated();
    }
  }
}
