    "lint": "echo 'No linting configured'",
    "test": "node --test lib/*.test.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.2",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.3"
  },
  "private": true
}
